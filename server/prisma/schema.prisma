generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RECYCLER
  COLLECTOR
  FACILITY
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CollectorAvailability {
  AVAILABLE
  UNAVAILABLE
  ON_COLLECTION
  OFFLINE
}

enum FacilityMembershipRole {
  OWNER
  MANAGER
  STAFF
}

enum CollectionStatus {
  PENDING
  WAITING_FOR_ADMIN
  COLLECTOR_ASSIGNED
  COLLECTOR_ON_THE_WAY
  COLLECTOR_ARRIVED
  COLLECTED
  VERIFICATION_PENDING
  VERIFIED
  COMPLETED
  CANCELLED
  REJECTED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  DECLINED
  REVOKED
  COMPLETED
}

enum RewardTransactionType {
  EARN
  REDEEM
  ADJUSTMENT
}

enum RedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  REJECTED
  CANCELLED
}

enum NotificationType {
  COLLECTION_REQUEST_CREATED
  COLLECTOR_ASSIGNED
  COLLECTOR_ON_THE_WAY
  COLLECTOR_ARRIVED
  COLLECTION_COMPLETED
  MATERIAL_VERIFIED
  POINTS_AWARDED
  REWARD_REDEEMED
  COLLECTOR_REGISTRATION
  FACILITY_REGISTRATION
  REPORT_SUBMITTED
}

enum ReportType {
  INCORRECT_INFORMATION
  SUGGEST_NEW_FACILITY
  COLLECTOR_PROBLEM
  COLLECTION_PROBLEM
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model User {
  id                       String                    @id @default(cuid())
  email                    String                    @unique
  passwordHash             String
  role                     UserRole
  status                   AccountStatus             @default(ACTIVE)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  sessions                 Session[]
  recyclerProfile          RecyclerProfile?
  collectorProfile         CollectorProfile?
  createdFacilities        Facility[]                @relation("FacilityCreator")
  facilityMemberships      FacilityMembership[]
  createdCollectionRequests CollectionRequest[]       @relation("RequestOwner")
  assignmentsMade          CollectionAssignment[]    @relation("AssignmentAdmin")
  statusEvents             CollectionStatusEvent[]  @relation("StatusActor")
  weightsRecorded          CollectionWeight[]        @relation("WeightRecorder")
  weightsVerified          CollectionWeight[]        @relation("WeightVerifier")
  rewardWallet             RewardWallet?
  notifications            Notification[]
  reports                  Report[]
  adminAuditLogs            AdminAuditLog[]

  @@index([role, status])
}

model Session {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RecyclerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CollectorProfile {
  id                    String                @id @default(cuid())
  userId                String                @unique
  approvalStatus        ApprovalStatus        @default(PENDING)
  availability          CollectorAvailability @default(OFFLINE)
  serviceArea           String?
  serviceRadiusKm       Float?
  serviceCenterLatitude Float?
  serviceCenterLongitude Float?
  vehicleType           String?
  vehicleDescription    String?
  vehicleRegistration   String?
  currentLatitude       Float?
  currentLongitude      Float?
  lastLocationUpdatedAt DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments           CollectionAssignment[]

  @@index([approvalStatus, availability])
}

model Facility {
  id              String               @id @default(cuid())
  name            String
  address         String
  latitude        Float
  longitude       Float
  phone           String?
  email           String?
  website         String?
  approvalStatus  ApprovalStatus       @default(PENDING)
  isSuspended     Boolean              @default(false)
  createdByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       User?                @relation("FacilityCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  memberships     FacilityMembership[]
  openingHours    FacilityOpeningHour[]
  materials       FacilityMaterial[]
  requests        CollectionRequest[]
  verifiedWeights CollectionWeight[]
  reports         Report[]

  @@index([approvalStatus, name])
}

model FacilityMembership {
  id         String                @id @default(cuid())
  facilityId String
  userId     String
  role       FacilityMembershipRole @default(STAFF)
  createdAt  DateTime              @default(now())
  facility   Facility              @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([facilityId, userId])
  @@index([userId])
}

model FacilityOpeningHour {
  id         String   @id @default(cuid())
  facilityId String
  dayOfWeek  Int
  opensAt    String?
  closesAt   String?
  isClosed   Boolean  @default(false)
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, dayOfWeek])
}

model Material {
  id            String              @id @default(cuid())
  slug          String              @unique
  name          String              @unique
  isActive      Boolean             @default(true)
  facilityLinks FacilityMaterial[]
  rewardRates   MaterialRewardRate[]
  requests      CollectionRequest[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model FacilityMaterial {
  facilityId String
  materialId String
  intakeNotes String?
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@id([facilityId, materialId])
  @@index([materialId])
}

model MaterialRewardRate {
  id           String   @id @default(cuid())
  materialId   String
  pointsPerKg  Int
  startsAt     DateTime @default(now())
  endsAt       DateTime?
  createdAt    DateTime @default(now())
  material     Material @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@unique([materialId, startsAt])
  @@index([materialId, endsAt])
}

model CollectionRequest {
  id                   String                   @id @default(cuid())
  requesterId          String
  materialId           String
  destinationFacilityId String?
  estimatedKg          Decimal                  @db.Decimal(8, 2)
  requestedFor         DateTime
  requestedWindowEnd   DateTime?
  pickupAddress        String
  pickupLatitude       Float
  pickupLongitude      Float
  status               CollectionStatus         @default(PENDING)
  cancellationReason   String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  requester            User                     @relation("RequestOwner", fields: [requesterId], references: [id], onDelete: Restrict)
  material             Material                 @relation(fields: [materialId], references: [id], onDelete: Restrict)
  destinationFacility  Facility?                @relation(fields: [destinationFacilityId], references: [id], onDelete: SetNull)
  assignments          CollectionAssignment[]
  statusEvents         CollectionStatusEvent[]
  weight               CollectionWeight?
  rewardTransactions   RewardTransaction[]

  @@index([requesterId, createdAt])
  @@index([status, requestedFor])
  @@index([destinationFacilityId, status])
}

model CollectionAssignment {
  id                String           @id @default(cuid())
  requestId         String
  collectorProfileId String
  assignedByUserId  String
  status            AssignmentStatus @default(ASSIGNED)
  assignedAt        DateTime         @default(now())
  acceptedAt        DateTime?
  unassignedAt      DateTime?
  reason            String?
  request           CollectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  collector         CollectorProfile @relation(fields: [collectorProfileId], references: [id], onDelete: Restrict)
  assignedBy        User             @relation("AssignmentAdmin", fields: [assignedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId, assignedAt])
  @@index([collectorProfileId, status])
}

model CollectionStatusEvent {
  id        String           @id @default(cuid())
  requestId String
  actorId   String?
  fromStatus CollectionStatus?
  toStatus  CollectionStatus
  note      String?
  createdAt DateTime         @default(now())
  request   CollectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor     User?            @relation("StatusActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model CollectionWeight {
  id                String            @id @default(cuid())
  requestId         String            @unique
  estimatedKg       Decimal           @db.Decimal(8, 2)
  actualKg          Decimal?          @db.Decimal(8, 2)
  verifiedKg        Decimal?          @db.Decimal(8, 2)
  recordedByUserId  String?
  verifiedByUserId  String?
  verifiedFacilityId String?
  recordedAt        DateTime?
  verifiedAt        DateTime?
  request           CollectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  recordedBy        User?             @relation("WeightRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  verifiedBy        User?             @relation("WeightVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedFacility  Facility?         @relation(fields: [verifiedFacilityId], references: [id], onDelete: SetNull)

  @@index([verifiedFacilityId, verifiedAt])
}

model RewardWallet {
  id            String              @id @default(cuid())
  userId        String              @unique
  pointsBalance Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  RewardTransaction[]
  redemptions   RewardRedemption[]
}

model RewardTransaction {
  id              String                @id @default(cuid())
  walletId        String
  requestId       String?
  redemptionId    String?               @unique
  type            RewardTransactionType
  pointsDelta     Int
  randValueCents  Int
  idempotencyKey  String                @unique
  description     String?
  createdAt       DateTime              @default(now())
  wallet          RewardWallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  request         CollectionRequest?    @relation(fields: [requestId], references: [id], onDelete: Restrict)
  redemption      RewardRedemption?     @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
}

model RewardRedemption {
  id           String            @id @default(cuid())
  walletId     String
  reference    String            @unique
  pointsCost   Int
  valueCents   Int
  status       RedemptionStatus  @default(REQUESTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  wallet       RewardWallet      @relation(fields: [walletId], references: [id], onDelete: Restrict)
  transaction  RewardTransaction?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model Report {
  id                 String       @id @default(cuid())
  reporterId         String
  facilityId         String?
  type               ReportType
  status             ReportStatus @default(OPEN)
  description        String
  suggestedName      String?
  suggestedAddress   String?
  suggestedLatitude  Float?
  suggestedLongitude Float?
  suggestedAcceptedMaterials String[] @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  reporter           User         @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  facility           Facility?    @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String
  entityType String
  entityId  String
  action    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([adminId, createdAt])
}
